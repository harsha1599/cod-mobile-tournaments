{
  "name": "cod-mobile-tournaments",
  "version": "2.0.0",
  "description": "A competitive tournament platform for Call of Duty Mobile gamers with integrated payment processing and real-time leaderboards",
  "main": "script.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.html",
    "lint:fix": "eslint . --ext .js,.html --fix",
    "format": "prettier --write \"**/*.{js,html,css,md,json}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "deploy": "npm run build && gh-pages -d dist",
    "serve": "python3 -m http.server 8000"
  },
  "keywords": [
    "call-of-duty",
    "mobile-gaming",
    "tournaments",
    "esports",
    "competitive-gaming",
    "leaderboards",
    "payments"
  ],
  "author": "harsha1599",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.3",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.50.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.1",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "vite": "^4.5.0",
    "gh-pages": "^6.0.0"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not dead"
  ]
}
