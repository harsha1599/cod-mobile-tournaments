# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Razorpay Configuration
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Email Service Configuration
VITE_EMAIL_SERVICE_PROVIDER=sendgrid # or mailgun, aws-ses
VITE_EMAIL_API_KEY=your_email_service_api_key
VITE_EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# Application Configuration
VITE_APP_NAME=CoD Mobile Tournaments
VITE_APP_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000/api

# Feature Flags
VITE_ENABLE_EMAIL_VERIFICATION=true
VITE_ENABLE_STREAMING=true
VITE_ENABLE_ANALYTICS=true

# Payment Configuration
VITE_MIN_PAYOUT_AMOUNT=500
VITE_MAX_PAYOUT_AMOUNT=100000
VITE_PAYMENT_GATEWAY=razorpay

# Streaming Platforms
VITE_TWITCH_CLIENT_ID=your_twitch_client_id
VITE_YOUTUBE_API_KEY=your_youtube_api_key

# Admin Configuration
VITE_ADMIN_EMAILS=admin@example.com,moderator@example.com
